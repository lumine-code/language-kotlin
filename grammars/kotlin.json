{
  "name": "Kotlin",
  "scopeName": "source.kotlin",
  "type": "tree-sitter",
  "parser": "tree-sitter-kotlin",
  "injectionNames": ["kotlin"],
  "fileTypes": ["kt", "kts", "ktm"],
  "comments": {
    "start": "// "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:fwcd/tree-sitter-kotlin#d6af96d2e23ef0a8ff5ab512864378cf08fba311",
    "wasmBuildTool": "tree-sitter-cli#v0.27.1",
    "grammar": "kotlin.wasm",
    "tagsQuery": "kotlin-tags.scm",
    "highlightsQuery": "kotlin-highlights.scm",
    "indentsQuery": "kotlin-indents.scm",
    "injectionsQuery": "kotlin-injections.scm",
    "foldsQuery": "kotlin-folds.scm"
  }
}
