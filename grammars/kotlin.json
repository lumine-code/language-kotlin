    "parserSource": "github:fwcd/tree-sitter-kotlin#1852ea17b7f60fb3f9d84e0b1555d56b46b39fb1",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "kotlin.wasm",
    "tagsQuery": "kotlin-tags.scm",
    "highlightsQuery": "kotlin-highlights.scm",
    "injectionsQuery": "kotlin-injections.scm"
  }
}
